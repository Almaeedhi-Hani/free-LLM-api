# AI Dynamic Optimization Agent - Environment Variables
# Copy to .env.local and fill in actual values

# FreeLLMAPI (Render) - unified LLM gateway
FREELLM_API_URL=https://free-llm-api-1-didl.onrender.com
FREELLM_API_KEY=
FREELLM_MODEL=gpt-4o-mini

# API Keys for AI search engines and optimization
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# IndexNow (Bing) key - must match the {key}.txt file served on your domain
INDEXNOW_KEY=

# Google Indexing API service account JWT assertion (for URL_UPDATED notifications)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Secret for protecting the cron agent route and revalidation endpoint
CRON_SECRET=
REVALIDATION_SECRET=

# Supabase (optional, for persistent content store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=content_store
